# Hush uses only an Ollama-compatible open-weight model provider.
# In local development, OLLAMA_BASE_URL defaults to http://127.0.0.1:11434.
# Production deployments must set OLLAMA_BASE_URL to an authorized, reachable host.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000

# Optional: server-side bearer token for an authorized Ollama-compatible host.
# Never expose this value with a NEXT_PUBLIC_ prefix or commit a real token.
# OLLAMA_API_TOKEN=

# Optional-sync configuration. These values are required only for anonymous
# Supabase sessions and explicitly saved conversation sync.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only 32-byte AES-256 key, Base64-encoded. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Set the generated value in .env.local or the deployment secret manager.
HUSH_SYNC_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY
